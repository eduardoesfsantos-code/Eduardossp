{
  "name": "obraponto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dois aplicativos de controle de ponto para obras com sincronizacao em tempo real",
  "scripts": {
    "setup": "node setup.mjs",
    "dev": "concurrently -k -n API,APP -c cyan,magenta \"node --watch server.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node server.js",
    "check": "node --check server.js && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
